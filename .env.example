# ============================================================
# Lumie — variáveis de ambiente
# Uso: copie este arquivo para ".env" (cp .env.example .env),
# preencha OLLAMA_API_KEY e rode: docker compose up --build
# NUNCA commite o ".env". Só o ".env.example" vai para o Git.
# Todos os valores abaixo são fictícios/padrão.
# ============================================================

# --- Geral ---
# Ambiente de execução do Node (production = sem logs de depuração das bibliotecas)
NODE_ENV=production
# Nível de detalhe dos logs do backend (error, warn, info, debug)
LOG_LEVEL=info

# --- Portas (no SEU computador) ---
# Porta para abrir o Lumie no navegador: http://localhost:3000
FRONTEND_PORT=3000
# Porta da API. O backend também escuta nela dentro do container.
# O navegador NÃO usa esta porta: o front chama /api/... e o nginx repassa ao backend.
BACKEND_PORT=3001

# --- Modelo de linguagem (Ollama Cloud) ---
# Endereço da API do modelo na nuvem (não há modelo local)
OLLAMA_BASE_URL=https://ollama.com
# Chave da API. Crie em https://ollama.com/settings/keys e cole aqui (só no .env!)
OLLAMA_API_KEY=COLE_SUA_CHAVE_AQUI
# Nome do modelo. Alternativa mais leve, se o 120b for lento ou limitado: gpt-oss:20b
OLLAMA_MODEL=gpt-oss:120b
# Tempo máximo de espera por resposta do modelo, em milissegundos (60000 = 60 s)
OLLAMA_TIMEOUT_MS=60000
# "Criatividade" do modelo (0 a 1). Baixa = respostas mais previsíveis
OLLAMA_TEMPERATURE=0.2
# true = IA FALSA (sem rede, sem chave). false = modelo real (backend/src/ia).
# Só troque para false depois que a ISA-04 e a ISA-05 estiverem prontas.
IA_FALSA=true

# --- Camada de segurança ---
# Quantas vezes pedir nova resposta ao modelo antes de usar a mensagem padrão
MAX_REGENERACOES=2

# --- Pipeline (valores iniciais: AJUSTAR testando com os laudos sintéticos) ---
# Tamanho máximo do laudo enviado, em MB. Deve ficar ABAIXO de 20
# (limite do nginx em frontend/nginx.conf.template) e do tmpfs de 50 MB do compose.
UPLOAD_MAX_MB=10
# Pasta dos uploads temporários dentro do container (tmpfs em memória no compose)
UPLOAD_DIR=/app/uploads
# Confiança mínima da extração (0 a 1), por item e por laudo. Abaixo disso, pedir novo envio.
# 0.80 = no PDF digital, só passa o item com nome, valor, unidade e faixa lidos.
# Motivo e regras: docs/confianca-extracao.md
CONFIANCA_MINIMA_EXTRACAO=0.80
# Confiança mínima média do OCR (0 a 100, escala do Tesseract)
CONFIANCA_MINIMA_OCR=70
# Idiomas do OCR: português + inglês (siglas como TSH, HDL). Os arquivos já vêm na imagem
OCR_LANG=por+eng

# --- Base de conhecimento ---
# Caminho DENTRO do container do back. O docker-compose monta
# ./docs/base-conhecimento em /app/knowledge (somente leitura).
KNOWLEDGE_BASE_PATH=/app/knowledge/exames.json

# --- Sessão do chat (em memória, sem banco de dados) ---
# Minutos até o laudo estruturado da sessão ser descartado
SESSION_TTL_MINUTES=30
