# ============================================================
# Lumie — variáveis de ambiente
# Uso: copie este arquivo para ".env" (cp .env.example .env),
# preencha OLLAMA_API_KEY e rode com Docker.
# NUNCA commite o ".env". Só o ".env.example" vai para o Git.
# ============================================================

# --- Geral ---
NODE_ENV=development
LOG_LEVEL=info

# --- Portas (host) ---
FRONTEND_PORT=3000
BACKEND_PORT=3001

# --- Front -> API ---
# Esta URL é usada pelo NAVEGADOR (que roda no seu computador, fora do Docker),
# por isso é "localhost" e não o nome do serviço.
# [CONFIRMAR] o prefixo depende da ferramenta do front: Vite = VITE_, Create React App = REACT_APP_.
VITE_API_URL=http://localhost:3001

# CORS: origem do front permitida pelo back
CORS_ORIGIN=http://localhost:3000

# --- Modelo de linguagem (Ollama Cloud) ---
# Crie a chave em https://ollama.com/settings/keys
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=COLE_SUA_CHAVE_AQUI
OLLAMA_MODEL=gpt-oss:120b
# Alternativa mais leve, se o 120b for lento ou limitado: gpt-oss:20b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_TEMPERATURE=0.2

# --- Camada de segurança ---
# Quantas vezes pedir nova resposta ao modelo antes de usar a mensagem padrão
MAX_REGENERACOES=2

# --- Pipeline (valores iniciais: AJUSTAR testando com os laudos sintéticos) ---
UPLOAD_MAX_MB=10
# Confiança mínima da extração (0 a 1). Abaixo disso, pedir novo envio.
CONFIANCA_MINIMA_EXTRACAO=0.80
# Confiança mínima média do OCR (0 a 100, escala do Tesseract)
CONFIANCA_MINIMA_OCR=70
OCR_LANG=por

# --- Base de conhecimento ---
# Caminho DENTRO do container do back. O docker-compose deve montar
# ./docs/base-conhecimento em /app/knowledge (somente leitura).
KNOWLEDGE_BASE_PATH=/app/knowledge/exames.json

# --- Sessão do chat (em memória, sem banco de dados) ---
SESSION_TTL_MINUTES=30
